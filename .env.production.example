NODE_ENV=production
POSTGRES_DB=bodycast
POSTGRES_USER=bodycast
POSTGRES_PASSWORD=replace_with_strong_database_password
DATABASE_URL=postgresql://bodycast:replace_with_url_encoded_password@db:5432/bodycast
IOS_SHORTCUT_API_KEY=replace_with_long_random_secret
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
BETTER_AUTH_URL=https://bodycast.example.com
AUTH_TRUSTED_ORIGINS=https://bodycast.example.com
# Comma-separated reverse-proxy addresses/CIDRs; production startup fails closed if empty.
AUTH_TRUSTED_PROXIES=replace_with_trusted_proxy_cidr
AUTH_PUBLIC_REGISTRATION_ENABLED=false
AUTH_PROFILE_ONE_BOOTSTRAP_ENABLED=false
# Set the exact owner address only for the separately authorized Profile 1 OTP bootstrap.
# AUTH_PROFILE_ONE_OWNER_EMAIL=
LEGACY_IOS_SHORTCUT_ENABLED=false
BREVO_API_KEY=replace_with_server_side_brevo_key
BREVO_SENDER_EMAIL=bodycast@example.com
BREVO_SENDER_NAME=BodyCast
AUTH_EMAIL_DAILY_LIMIT=250
AUTH_EMAIL_RECIPIENT_DAILY_LIMIT=10
