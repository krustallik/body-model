# Dedicated one-shot tool image. Build context must be the exact approved
# legacy source commit; callers add only this reviewed Dockerfile and the
# read-only evidence/validation wrappers from the main release tooling.
FROM docker.io/library/node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
ENV NODE_ENV=production
COPY prisma ./prisma
RUN DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build npx prisma generate --schema prisma/schema.prisma
COPY src ./src
COPY tsconfig.json ./tsconfig.json
COPY scripts/production-full-history-recalculate.ts ./scripts/production-full-history-recalculate.ts
COPY scripts/production-v4-recovery-evidence.ts ./scripts/production-v4-recovery-evidence.ts
COPY scripts/production-v4-derived-recovery.mjs /app/dist/production-v4-derived-recovery.mjs
RUN mkdir -p /app/dist \
  && ./node_modules/.bin/esbuild scripts/production-full-history-recalculate.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=/app/dist/production-full-history-recalculate.mjs \
  && ./node_modules/.bin/esbuild scripts/production-v4-recovery-evidence.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=/app/dist/production-v4-recovery-evidence.mjs
USER node
CMD ["node", "/app/dist/production-full-history-recalculate.mjs", "--derived-v4-recovery", "--owner-authorized", "--profile-id", "1"]
