{
  "name": "bodycast",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/validate-env.ts && next dev --hostname 127.0.0.1",
    "build": "tsx scripts/validate-env.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "benchmark:recovery": "tsx scripts/benchmark-model-recovery.ts",
    "validate:recovery-support": "tsx scripts/validate-recovery-support.ts",
    "validate:recovery-calibration": "tsx scripts/validate-recovery-calibration.ts",
    "validate:initialization": "tsx scripts/validate-initialization-v5.ts",
    "validate:initialization:smoke": "tsx scripts/ci/validate-initialization-smoke.ts",
    "validate:workout-activity-v6": "tsx scripts/validate-workout-activity-v6.ts",
    "validate:workout-activity-v6:smoke": "tsx scripts/validate-workout-activity-v6.ts",
    "benchmark:forecast": "tsx scripts/benchmark-model-forecast.ts",
    "benchmark:target-solver": "tsx scripts/benchmark-target-solver.ts",
    "backup:postgres": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-postgres.ps1",
    "verify:postgres-restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-postgres-restore.ps1",
    "validate:target-solver": "tsx scripts/validate-target-solver-phase16b.ts",
    "validate:target-solver:smoke": "tsx scripts/ci/validate-target-solver-smoke.ts",
    "validate:forecast-calibration": "tsx scripts/validate-forecast-calibration.ts",
    "validate:forecast-stress": "tsx scripts/validate-forecast-stress.ts",
    "qa:forecast-fixture": "tsx scripts/qa/forecast-fixture.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "env:check": "tsx scripts/validate-env.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.185.3",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "gltf-validator": "^2.0.0-dev.3.10",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "three": "0.186.1",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^3.2.0"
  }
}
