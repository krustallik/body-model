generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HealthCheck {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}

model Profile {
  id             Int       @id @default(1)
  sex            String    @db.VarChar(6)
  dateOfBirth    DateTime  @db.Date
  heightCm       Decimal   @db.Decimal(6, 2)
  targetWeightKg Decimal?  @db.Decimal(6, 2)
  targetDate     DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model DailyHealthData {
  id                      Int                  @id @default(autoincrement())
  date                    String               @unique @db.VarChar(10)
  weightKg                Float?
  bodyFatPercent          Decimal?             @db.Decimal(10, 4)
  caloriesKcal            Float?
  proteinG                Float?
  fatG                    Float?
  carbsG                  Float?
  steps                   Int?
  activeEnergyKcal        Float?
  averageWalkingSpeedKmh  Decimal?             @db.Decimal(10, 4)
  walkingDistanceKm       Decimal?             @db.Decimal(10, 4)
  strengthTrainingMinutes Decimal?             @db.Decimal(10, 4)
  rawPayload              Json
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  workouts                Workout[]
  syncSnapshots           HealthSyncSnapshot[]
}

model HealthSyncSnapshot {
  id                      Int              @id @default(autoincrement())
  dailyHealthDataId       Int?
  date                    String           @db.VarChar(10)
  receivedAt              DateTime         @default(now()) @db.Timestamptz(3)
  syncedAt                DateTime?        @db.Timestamptz(3)
  timezone                String           @db.VarChar(100)
  weightKg                Float?
  bodyFatPercent          Decimal?         @db.Decimal(10, 4)
  caloriesKcal            Float?
  proteinG                Float?
  fatG                    Float?
  carbsG                  Float?
  steps                   Int?
  activeEnergyKcal        Float?
  averageWalkingSpeedKmh  Decimal?         @db.Decimal(10, 4)
  walkingDistanceKm       Decimal?         @db.Decimal(10, 4)
  strengthTrainingMinutes Decimal?         @db.Decimal(10, 4)
  rawPayload              Json
  dailyHealthData         DailyHealthData? @relation(fields: [dailyHealthDataId], references: [id], onDelete: SetNull)

  @@index([date, receivedAt])
  @@index([dailyHealthDataId])
}

model Workout {
  id                Int             @id @default(autoincrement())
  dailyHealthDataId Int
  externalId        String?
  type              String
  startAt           DateTime
  endAt             DateTime
  durationMinutes   Float?
  energyKcal        Float?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  dailyHealthData   DailyHealthData @relation(fields: [dailyHealthDataId], references: [id], onDelete: Cascade)

  @@index([dailyHealthDataId])
}

model WorkInterval {
  id        Int      @id @default(autoincrement())
  date      String   @db.VarChar(10)
  startAt   DateTime @db.Timestamptz(3)
  endAt     DateTime @db.Timestamptz(3)
  timezone  String   @db.VarChar(100)
  category  String   @db.VarChar(50)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([date, startAt])
  @@index([startAt, endAt])
}
