[Unit]
Description=BodyCast root production operation authority socket
Before=bodycast-production-operations.service

[Socket]
ListenStream=/run/bodycast/production-operations.sock
SocketUser=root
SocketGroup=bodycast-release
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true
Service=bodycast-production-operations.service

[Install]
WantedBy=sockets.target
